# Copy to ~/.config/quietglass/shoot-day.env  (chmod 600). Never commit the real file.
PORT=8896
HOST=127.0.0.1
# Where customers, projects, takes and schedule are stored. Systemd does not expand ~ or %h here: write the full path.
DATA_FILE=/home/YOUR-USER/.local/state/quietglass/shoot-day/shoot-day-data.json
# Uploaded PDFs/pictures (default: shoot-day-files next to DATA_FILE) and the largest upload in MB.
SHOOT_FILES_DIR=
SHOOT_MAX_UPLOAD_MB=20
# Voice commands: the whisper service (selfhost/services/whisper). Empty = voice off.
WHISPER_URL=http://127.0.0.1:8017/v1/audio/transcriptions
PRESET_LANG=de
# "Storyboard from PDF": an OpenAI-compatible language model (…/v1). Empty = manual entry only.
SHOOT_LLM_URL=
SHOOT_LLM_MODEL=
SHOOT_LLM_TOKEN=
# Card "Kunde vor dem Termin": Babel's memory (babel-llm-proxy base URL). Empty = nothing about Babel is shown.
SHOOT_BABEL_URL=
SHOOT_BABEL_TOKEN=
# Work Dashboard (one-way mirror of customers, projects, dates, ideas, talks): base URL (its MCP endpoint is <url>/mcp)
# and an agent token created in the dashboard ("Shoot Day Sync", starts with wd_). Empty = off.
SHOOT_WD_URL=
SHOOT_WD_TOKEN=
# Google Calendar: /exec URL of the Apps Script bridge (google-calendar-bridge.gs) and its secret. Empty = off. See README.
SHOOT_GCAL_WEBHOOK=
SHOOT_GCAL_SECRET=
# Optional: SHOOT_GCAL_CALENDAR=<calendar id>  SHOOT_GCAL_DURATION_MIN=60  SHOOT_TZ=Europe/Vienna
# Access: your Tailscale login(s) (no token needed through `tailscale serve`), and/or a shared secret.
SD_TAILSCALE_USERS=
TOKEN=
