# CareLink-Zugang fuer die Bruecke - NUR du traegst hier etwas ein (Datei bleibt chmod 600).
# Danach: cd /opt/nightscout && docker compose run --rm -it carelink login   (einmalig)
#         docker compose up -d carelink
CARELINK_USERNAME=BITTE_EINTRAGEN
CARELINK_PASSWORD=BITTE_EINTRAGEN
MMCONNECT_SERVER=EU
MMCONNECT_COUNTRYCODE=at
MMCONNECT_LANGCODE=de
# Nur fuer ein Care-Partner-Konto mit mehreren Patienten: CareLink-Benutzername des Patienten
CARELINK_PATIENT=
CARELINK_INTERVAL=300
CARELINK_QUIET=true
