# Copy to ~/.config/quietglass/quiet-hub-daemon.env  (chmod 600). Never commit the real file.
# Full list of options: apps/quiet-hub/.env-hub.example
PORT=8787
HOST=127.0.0.1
# Your Tailscale login(s): accepted without a token through `tailscale serve`.
HUB_TAILSCALE_USERS=
# For relays on OTHER machines (and as an alternative login): a long random token (openssl rand -hex 24).
HUB_TOKEN=
# Voice for the hub: the whisper service
WHISPER_URL=http://127.0.0.1:8017/v1/audio/transcriptions
# Reply suggestions from an OpenAI-compatible LLM; VLLM_URL=off switches them off
# VLLM_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=qwen
# Home Assistant / printer (optional, otherwise labelled DEMO)
# HA_URL=
# HA_TOKEN=
# HA_DEVICES=
# Zuhause page (glasses 0.7.0+): favourites in order, areas (auto | off | names), never-shown entities
# HA_FAVORITES=
# HA_AREAS=auto
# HA_EXCLUDE=
# Locks / alarm / garage: hidden unless listed (lock,alarm,garage); then always a second tap
# HA_SENSITIVE=
# HA_POLL_MS=5000
# MOONRAKER_URL=
