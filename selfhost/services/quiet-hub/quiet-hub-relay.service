# Quiet Hub relay: one per machine that has agents (Claude Code, Codex, Hermes, OpenClaw). User service:
#   mkdir -p ~/.config/quietglass ~/.config/quiet-hub ~/.config/systemd/user
#   cp ~/quietglass-g2/apps/quiet-hub/examples/relay.example.json ~/.config/quiet-hub/relay.json   # then edit
#   cp relay.env.example ~/.config/quietglass/quiet-hub-relay.env && chmod 600 ~/.config/quietglass/quiet-hub-relay.env
#   cp quiet-hub-relay.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now quiet-hub-relay
#   loginctl enable-linger "$USER"
# Code lives in the repo (not copied here): apps/quiet-hub/examples/quiet-hub-relay.mjs
[Unit]
Description=Quiet Hub relay - connects local agents to the hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/quietglass/quiet-hub-relay.env
ExecStart=/usr/bin/env node %h/quietglass-g2/apps/quiet-hub/examples/quiet-hub-relay.mjs --config %h/.config/quiet-hub/relay.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
