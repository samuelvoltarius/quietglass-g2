# Copy to ~/.config/quietglass/babel-llm-proxy.env  (chmod 600). Never commit the real file.

# The OpenAI-compatible LLM server that does the translation (vLLM, Ollama, llama.cpp server ...).
# Without /v1 at the end. vLLM default: http://127.0.0.1:8000   Ollama: http://127.0.0.1:11434
UPSTREAM=http://127.0.0.1:8000

# The proxy itself listens on loopback only (publish it with `tailscale serve`).
PORT=8121

# Access control. Empty TOKEN = open inside your tailnet.
# If TOKEN is set, a request is accepted with "Authorization: Bearer <TOKEN>" OR - arriving through
# `tailscale serve` - with a Tailscale login listed in TAILSCALE_USERS (comma separated).
TOKEN=
TAILSCALE_USERS=

# Babel Glass 0.4.0: the app's own memory (summaries, agreements, notes). One JSON file, mode 600.
# Empty = babel-memory.json next to babel_llm_proxy.py (gitignored).
BABEL_MEMORY_FILE=
# Most entries kept; the oldest go first.
BABEL_MEMORY_CAP=500

# Optional: customer context from a local Shoot Day server (read-only) for reply suggestions,
# word finder and summary. Empty = off. Token = the Shoot Day server's TOKEN (if it has one).
BABEL_SHOOT_URL=
BABEL_SHOOT_TOKEN=
# Seconds for all Shoot Day lookups together; on timeout the context is just left out.
BABEL_SHOOT_TIMEOUT=2
