# Brillen-Melder - Vorlage. Kopieren nach ~/glass-notify/.env, chmod 600.
# Der Telegram-Token steht NICHT hier, sondern wird aus der Hermes-Datei gelesen.
NOTIFY_HERMES_ENV=~/.hermes/.env
# NOTIFY_CHAT_ID=            # nur falls ein anderer Chat als TELEGRAM_HOME_CHANNEL gewuenscht ist

# Waechter: ohne URL aus. Adressen im Tailnet (tailscale serve), Platzhalter ersetzen.
NOTIFY_KLIPPER_URL=https://drucker.example.ts.net:8898/api/printer
NOTIFY_BYD_URL=https://pi.example.ts.net:8471/state
NOTIFY_SUGAR_URL=https://server.example.ts.net:8462
NOTIFY_STATUS_URLS="Spark|https://spark.example.ts.net/status,Pi|https://pi.example.ts.net/status"

# Optionale Bearer-Tokens je Waechter (im Tailnet meist leer lassen)
# NOTIFY_KLIPPER_TOKEN=
# NOTIFY_BYD_TOKEN=
# NOTIFY_SUGAR_TOKEN=
# NOTIFY_STATUS_TOKEN=

NOTIFY_QUIET=23:00-07:00
NOTIFY_INTERVAL=60
# NOTIFY_TIMEOUT=10
# NOTIFY_STATE=~/.local/state/glass-notify/state.json
# NOTIFY_BYD_TARGET=80
# NOTIFY_SUGAR_LOW=70
# NOTIFY_SUGAR_URGENT=55
# NOTIFY_SUGAR_HIGH=250
# NOTIFY_SUGAR_STALE_MIN=20
# NOTIFY_DOWN_MIN=5
