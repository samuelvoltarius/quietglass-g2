# Copy to ~/.config/quietglass/status-server.env  (chmod 600). Never commit the real file.
PORT=8199
HOST=127.0.0.1
# Shown as the source name in the app
NAME=my-server
# Access: your Tailscale login(s), comma separated, accepted without a token through `tailscale serve`.
STATUS_TAILSCALE_USERS=
# Alternative / additional: shared secret (the app then needs it in the source URL settings).
TOKEN=
