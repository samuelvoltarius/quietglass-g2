# ha-relay settings (copy to ~/ha-relay/.env, chmod 600). Never commit the filled-in file.
# Home Assistant, as reachable from the machine that runs the relay.
HA_URL=http://192.0.2.10:8123
# File with the long-lived access token (absolute path: systemd does not expand ~ here). Created chmod 600, never logged.
HA_TOKEN_FILE=/home/you/.ha_token

# Listens on loopback only; `tailscale serve --https=8483` publishes it.
RELAY_HOST=127.0.0.1
RELAY_PORT=8484

# Who may connect: Tailscale logins (comma separated) as set by `tailscale serve`. Empty = everything is refused.
RELAY_TAILSCALE_USERS=you@example.com

# Entities call_service may target (comma separated, list the remote.* ones too). Empty = every media_player.* / remote.*.
RELAY_ENTITIES=media_player.living_room_tv,remote.living_room_tv,media_player.projector

# Devices handed to the app at GET /config: media_player|remote (may be empty)|name ; next device ...
RELAY_DEVICES=media_player.living_room_tv|remote.living_room_tv|Living Room;media_player.projector||Projector
