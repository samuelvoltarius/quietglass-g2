# Copy to .env next to docker-compose.yml (not committed). All lines are optional.

# Region(s) to build, space separated Geofabrik URLs: https://download.geofabrik.de/
#   one country : https://download.geofabrik.de/europe/austria-latest.osm.pbf
#   DACH        : https://download.geofabrik.de/europe/austria-latest.osm.pbf https://download.geofabrik.de/europe/germany-latest.osm.pbf https://download.geofabrik.de/europe/switzerland-latest.osm.pbf
#   all Europe  : https://download.geofabrik.de/europe-latest.osm.pbf   (~35 GB download, ~35 GB tiles, ~48 GB RAM, hours)
TILE_URLS=https://download.geofabrik.de/europe/austria-latest.osm.pbf

# RAM cap for the container (country: 16g, DACH: 32g, Europe: 48g) and CPU cap
MEM_LIMIT=16g
CPUS=8.0
SERVER_THREADS=4

# Pin the image once it works, e.g. ghcr.io/nilsnolde/docker-valhalla/valhalla@sha256:<digest>
# (the reference setup ran Valhalla 3.5.1)
# VALHALLA_IMAGE=ghcr.io/nilsnolde/docker-valhalla/valhalla:latest
