# Copy to ~/.config/quietglass/whisper.env  (chmod 600). Never commit the real file.

# Ports. Keep both on loopback and publish them only with `tailscale serve`.
HTTP_HOST=127.0.0.1
WHISPER_GPU_PORT=8017
WS_HOST=127.0.0.1
WS_PORT=8120

# Model (downloaded once from Hugging Face; afterwards HF_HUB_OFFLINE=1 in the unit keeps it offline).
MODEL=openai/whisper-large-v3-turbo

# Babel WebSocket login. Leave BOTH empty to allow every tailnet device (the port is only
# reachable inside your tailnet). Set TAILSCALE_USERS to your tailnet login(s) to require a login,
# or TOKEN for a shared secret. When either is set the WebSocket checks it.
TOKEN=
TAILSCALE_USERS=

# Optional vocabulary hint for German (names, jargon), comma separated. Empty = none.
WHISPER_PROMPT=

# Tuning (defaults are fine)
# WINDOW=3.0        seconds of audio per Babel caption chunk
# MIN_RMS=0.006     quieter chunks are treated as silence
# WHISPER_MIN_BYTES=12000   shorter uploads return an empty text
