# ~/byd-bridge/.env  (chmod 600)
BYD_HOST=127.0.0.1
BYD_PORT=8472
# Tailscale logins allowed through `tailscale serve` (trusted from loopback only)
BYD_TAILSCALE_USERS=you@example.com
# optional bearer token for curl tests (never put it into the app)
BYD_TOKEN=

# MQTT broker with the Panoptes telemetry (surfmate/vehicle/telemetry/<field>) and the pybyd-mqtt bridge
BYD_MQTT_HOST=127.0.0.1
BYD_MQTT_PORT=1883
BYD_TOPIC=surfmate/vehicle/telemetry
# (the old Overdrive app: BYD_TOPIC=overdrive/vehicle/telemetry)
BYD_CLOUD_TOPIC=bydcloud/bydsurf

# Vehicle commands: 0 = OFF, read only (POST /command always 403). This is the default.
# 1 = lock / unlock / preheat from the glasses (Alfred 23.10.2026). The guards are ALWAYS on and cannot be
# switched off here: fresh power_level 0 (<= 180 s, never retained), arm + second tap, 15 s gap,
# max 6 per hour (BYD_RATE_FILE), Telegram before every unlock, no climate off.
BYD_CONTROL=0
# Signed channel to pybyd-mqtt (cmd/signed, brille/unlock): the HMAC secret file (chmod 600), never in Git.
BYD_CMD_SECRET_FILE=~/byd-copilot/.cmd_secret
# 1 = pybyd-mqtt knows the signed "preheat" action (proposed/ deployed); otherwise preheat is "not set up"
BYD_PREHEAT=0
# 1 = unlock allowed (needs the proposed befehl_gate with the glasses' own unlock source deployed)
BYD_ALLOW_UNLOCK=0
# Persistent counter for the rate limit (survives restarts; unreadable = blocked)
BYD_RATE_FILE=~/byd-bridge/rate.json
# Unlock notification (Telegram Bot API sendMessage). Without both, every unlock is refused.
# Either here (this file is the systemd EnvironmentFile, chmod 600) ...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ... or in a separate file with the same two lines:
BYD_TELEGRAM_ENV=
BYD_LOG=~/byd-bridge/commands.jsonl

# Thresholds
BYD_TYRE_LOW_KPA=210
BYD_12V_LOW=12.2
BYD_SOC_LOW=15
BYD_STALE_S=120
BYD_UNLOCKED_MIN=10
