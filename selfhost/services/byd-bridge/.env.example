# ~/byd-bridge/.env  (chmod 600)
BYD_HOST=127.0.0.1
BYD_PORT=8472
# Tailscale logins allowed through `tailscale serve` (trusted from loopback only)
BYD_TAILSCALE_USERS=you@example.com
# optional bearer token for curl tests (never put it into the app)
BYD_TOKEN=

# MQTT broker with the Overdrive telemetry and the pybyd-mqtt bridge
BYD_MQTT_HOST=127.0.0.1
BYD_MQTT_PORT=1883
BYD_TOPIC=overdrive/vehicle/telemetry
BYD_CLOUD_TOPIC=bydcloud/bydsurf

# Commands: 0 = read only (POST /command always 403)
BYD_CONTROL=1
# 1 = pybyd-mqtt knows cmd/climate_temp (see README "Erweiterung"); 0 = only heat 26 / cool 19
BYD_CLIMATE_TEMP_TOPIC=0
# 1 = pybyd-mqtt knows cmd/lock and cmd/unlock (see README "Erweiterung")
BYD_LOCK_TOPICS=0
# alternative for lock/unlock: a local service with POST /action {"name","arg"} (leave empty if unsure)
BYD_ACTION_URL=
# Unlocking from the glasses: off unless you really want it (also needs a lock path above)
BYD_ALLOW_UNLOCK=0
BYD_LOG=~/byd-bridge/commands.jsonl

# Thresholds
BYD_TYRE_LOW_KPA=210
BYD_12V_LOW=12.2
BYD_SOC_LOW=15
BYD_STALE_S=120
BYD_UNLOCKED_MIN=10
