# Copy to ~/.config/quietglass/klipper-bridge.env  (chmod 600). Never commit the real file.
PORT=8898
HOST=127.0.0.1
# Address of Moonraker (the Klipper API) on your LAN. Empty = the bridge searches your /24 network(s).
KL_MOONRAKER=http://printer.local:7125
# Only if you leave KL_MOONRAKER empty: which /24 to search, e.g. 10.0.0
# KL_SCAN_NET=
# Allow pause / resume / cancel from the glasses (needs a login below, otherwise ignored).
KL_ALLOW_CONTROL=0
# Access: your Tailscale login(s) (no token needed through `tailscale serve`), and/or a shared secret.
KL_TAILSCALE_USERS=
TOKEN=
