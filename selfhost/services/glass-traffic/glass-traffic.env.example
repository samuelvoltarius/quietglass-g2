# glass-traffic settings (copy to ~/glass-traffic/.env, chmod 600). Never commit the filled-in file.
TRAFFIC_HOST=127.0.0.1
TRAFFIC_PORT=8475
# Who may ask: Tailscale logins (comma separated) behind `tailscale serve`, and/or a bearer token.
TRAFFIC_TAILSCALE_USERS=you@example.com
TRAFFIC_TOKEN=

# (a) TomTom Traffic API (developer.tomtom.com, free tier). Empty = TomTom off.
TOMTOM_KEY=
TOMTOM_LANGUAGE=de-DE
# Flow samples along the route per request (0 = only incidents). Each sample is one TomTom call (cached 2 min).
TOMTOM_FLOW_SAMPLES=6
# Most boxes per route (one incidents call each, max 10 000 km^2 per box).
TOMTOM_MAX_BOXES=8

# (b) ASFINAG DATEX II (after registration + contract at https://contentportal.asfinag.at/). Empty = off.
# The URL of the SituationPublication (traffic messages / unplanned events) feed you get there.
ASFINAG_DATEX_URL=
ASFINAG_USER=
ASFINAG_PASSWORD=
