{
  "name": "@quietglass/status-glass",
  "version": "0.2.0",
  "description": "Quietglass Status Glass — homelab and service monitoring over an open protocol",
  "author": "Quietglass",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "evenhub-simulator --automation-port 9896 http://127.0.0.1:5196",
    "pack": "evenhub pack app.json dist -o"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
