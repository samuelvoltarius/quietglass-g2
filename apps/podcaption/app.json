{
  "package_id": "glass.quiet.podcaption",
  "edition": "202601",
  "name": "PodCaption",
  "version": "0.2.0",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Optional: read a podcast feed and its transcript through your own PodCaption bridge. Opening a file needs no network.",
      "whitelist": [
        "http://127.0.0.1:8789",
        "http://localhost:8789"
      ]
    }
  ],
  "supported_languages": [
    "de",
    "en",
    "fr",
    "es",
    "it"
  ]
}
