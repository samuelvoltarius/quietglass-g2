{
  "name": "@quietglass/field-log",
  "version": "0.2.0",
  "description": "Quietglass FieldLog — hands-free inspection logging",
  "author": "Quietglass",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "evenhub-simulator --automation-port 9898 http://127.0.0.1:5198",
    "pack": "evenhub pack app.json dist -o field-log.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
