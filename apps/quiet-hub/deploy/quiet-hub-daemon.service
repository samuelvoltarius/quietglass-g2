[Unit]
Description=Quiet Hub daemon - agent events, Home Assistant and printer bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/quietglass-g2/apps/quiet-hub
Environment=PATH=%h/.hermes/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/quietglass-g2/apps/quiet-hub/.env-hub
ExecStart=/usr/bin/env node examples/quiet-hub-daemon.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
