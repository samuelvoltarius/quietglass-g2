# Copy this file to .env-hub on the Pi. Never commit the real token.
HUB_TOKEN=replace-with-a-long-random-token
# Optional: tailnet logins (comma list) that need no token through `tailscale serve`.
# HUB_TAILSCALE_USERS=you@example.com
HERMES_BIN=/home/your-user/.local/bin/hermes
# Id of the Hermes that runs on the hub machine itself (LOCAL_AGENT=off to disable).
# LOCAL_AGENT_ID=hermes-pi5

# Voice: any OpenAI-compatible /v1/audio/transcriptions endpoint.
# WHISPER_URL=http://<spark-tailscale-ip>:8017/v1/audio/transcriptions
# WHISPER_MODEL=whisper-1
# WHISPER_LANG=de

# Optional completion-state and local AI services (follow-up suggestions).
# QUIET_HUB_STATE_FILE=/home/your-user/.local/state/quiet-hub/state.json
# VLLM_URL=http://<spark-tailscale-ip>:8000/v1
# VLLM_MODEL=qwen

# Approval cards expire (= deny) after this many ms.
# APPROVAL_TIMEOUT_MS=120000

# Tagesstart (morning briefing, 0.8.0). Every block is optional; unset = block hidden
# (the calendar says "keine Kalenderquelle"). All sources are fetched by the daemon only.
# Calendar: one or more ICS/iCal URLs (secret "private address" links stay in this file).
# BRIEF_ICS_URLS=https://calendar.example/private-abc/basic.ics,https://cloud.example/remote.php/dav/public-calendars/xyz?export
# Shoot Day projects dated today count as appointments too (GET <base>/api/projects and /api/customers).
# BRIEF_SHOOT_URL=http://127.0.0.1:8896
# BRIEF_SHOOT_TOKEN=
# Weather (Open-Meteo, no key). Since 0.8.2 the weather follows the wearer: the phone sends its position
# (rounded to ~1 km) with every /brief request, and the places of today's appointments (ICS LOCATION,
# Shoot Day place) get a forecast at the appointment hour. BRIEF_LAT/BRIEF_LON are now only the FALLBACK
# used when the phone sends no position; day boundaries in BRIEF_TZ (default: system zone).
# BRIEF_LAT=47.80
# BRIEF_LON=13.04
# Place names of appointments are looked up here (only the place text is sent; default: Open-Meteo geocoding).
# BRIEF_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# BRIEF_TZ=Europe/Vienna
# Car: BYD bridge base URL (GET /state); token only if the bridge wants one.
# BRIEF_BYD_URL=https://car-host.example:8455
# BRIEF_BYD_TOKEN=
# Glucose: sugar bridge (Nightscout read proxy) base URL. Information only.
# BRIEF_SUGAR_URL=https://sugar-host.example:8462
# BRIEF_SUGAR_TOKEN=
# Printer: Klipper Glance bridge (GET /api/printer); unset = MOONRAKER_URL above is used.
# BRIEF_KLIPPER_URL=http://127.0.0.1:8898
# BRIEF_KLIPPER_TOKEN=
# Servers: Status Glass reference servers, "Name|URL" comma list.
# BRIEF_STATUS_URLS=Pi|https://pi.example:8451/status,NAS|https://nas.example:8451/status
# BRIEF_STATUS_TOKEN=
# BRIEF_CACHE_MS=120000
# BRIEF_TIMEOUT_MS=6000
# BRIEF=off

# Home Assistant (without these, Home shows labelled DEMO devices).
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token>
# Allow-list: entity_id[=label], comma separated. Only these can ever be switched.
# HA_DEVICES=light.office=Buero Licht,switch.printer_plug=Drucker Steckdose,sensor.living_temp=Wohnzimmer
# Zuhause page: favourites in order (empty = HA_DEVICES), areas (auto | off | names), hidden entities.
# HA_FAVORITES=scene.abend=Abendlicht,light.office,cover.living_room
# HA_AREAS=auto
# HA_EXCLUDE=
# Locks / alarm / garage stay hidden unless named here (then always two-step): lock,alarm,garage
# HA_SENSITIVE=
# HA_POLL_MS=5000
# HUB_LANG=de

# Moonraker / Klipper (without this, Printer shows a labelled DEMO).
# MOONRAKER_URL=http://192.168.1.50:7125
