{
  "name": "@quietglass/star-glass",
  "version": "0.1.0",
  "description": "Quietglass Star Glass — N.I.N.A. imaging status on the Even G2: exposure, guiding, focus, equipment and the newest frame",
  "author": "Quietglass",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "evenhub-simulator --automation-port 9934 http://127.0.0.1:5234/?demo=1",
    "pack": "evenhub pack app.json dist -o star-glass.ehpk",
    "bridge": "node examples/star-bridge.mjs",
    "mock": "node examples/mock-nina.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
